{
  "name": "Report",
  "type": "object",
  "properties": {
    "reading_id": {
      "type": "string",
      "description": "id of the Reading this report is built from"
    },
    "scan_id": {
      "type": "string"
    },
    "pdf_file_uri": {
      "type": "string",
      "description": "private file_uri of the generated PDF"
    },
    "purchase_status": {
      "type": "string",
      "enum": [
        "locked",
        "unlocked",
        "generating",
        "failed"
      ],
      "default": "locked"
    }
  },
  "required": [
    "reading_id",
    "scan_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
{
  "name": "Scan",
  "type": "object",
  "properties": {
    "scan_type": {
      "type": "string",
      "enum": [
        "full",
        "quick",
        "compatibility"
      ],
      "default": "quick"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "analyzing",
        "analyzed",
        "failed"
      ],
      "default": "pending"
    },
    "right_hand_photo": {
      "type": "string",
      "description": "private file_uri of the right palm photo"
    },
    "left_hand_photo": {
      "type": "string",
      "description": "private file_uri of the left palm photo, optional"
    },
    "hidden_from_grimoire": { "type": "boolean", "default": false },
    "quality_notes": {
      "type": "string"
    },
    "error_message": {
      "type": "string"
    }
  },
  "required": [
    "scan_type",
    "right_hand_photo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}